# Same origin by default; Vite proxies /api including WebSocket to 127.0.0.1:8123.
# These values are public build-time URLs. Never put secrets in VITE_* variables.
VITE_API_BASE_URL=/api
# Optional HTTP(S) or WS(S) API base, including /api, for a separate WebSocket origin.
# VITE_WS_BASE_URL=https://gallery.example.com/api
